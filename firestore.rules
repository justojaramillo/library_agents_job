rules_version = '2';

// ADR-0003: toda lectura y escritura pasa por el servidor con el SDK de administración,
// que ignora estas reglas. El cliente (navegador) no accede nunca a Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
