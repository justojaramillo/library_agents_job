# No ejecutar scripts de instalación de las dependencias.
# - better-sqlite3 ya trae binarios precompilados; sin esto npm intenta compilarlo (necesita compilador de C++).
# - Es además una buena práctica de seguridad de la cadena de suministro: un paquete malicioso
#   no puede ejecutar código al instalarse. (`npm run <script>` del proyecto sí funciona.)
ignore-scripts=true
