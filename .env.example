# Copia este archivo a .env (nunca lo subas a git) y llena los valores desde la consola de Firebase.
# Los agentes no leen ni crean el .env real; solo este ejemplo.

# --- Firebase, servidor (SECRETOS; cuenta de servicio: Configuración del proyecto → Cuentas de servicio) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada con los saltos de línea escritos como \n, entre comillas dobles.
FIREBASE_PRIVATE_KEY=

# --- Firebase, navegador (no son secretos; Configuración del proyecto → Tus apps → Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
